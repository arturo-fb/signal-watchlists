# ── Secrets: never commit these ──────────────────────────────────────────────
# The repo is public. ANTHROPIC_API_KEY belongs in GitHub Secrets, not here.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
token.json
anthropic.txt
GMAIL.txt
NewsAPI.txt

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# ── Build output ─────────────────────────────────────────────────────────────
# docs/ is regenerated by the Action on every run and uploaded straight to
# Pages, so committing it would only create merge conflicts against a file
# nobody reads from git.
docs/

# preview/ is a local demo build with invented numbers — never publish it.
preview/

# ── Local scratch ────────────────────────────────────────────────────────────
.DS_Store
*.log
/tmp/
demo.db
*.db-journal
*.db-wal
*.db-shm

# NOTE: data/recommendations.db is deliberately NOT ignored. It is the ledger
# the site is built from and the Action needs it in the repo. It contains only
# tickers, prices, dates and theses — no keys, no member identities.
